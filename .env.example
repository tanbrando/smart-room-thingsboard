# ==============================================================================
# SMART ROOM DIGITAL TWIN - CONFIGURATION TEMPLATE (.env.example)
# Cách dùng: Sao chép thành file .env và điền 4 token từ ThingsBoard:
#   cp .env.example .env
# ==============================================================================

# ===== 1. THINGSBOARD MQTT BROKER & 4 ACCESS TOKENS (BẮT BUỘC) =====
TB_HOST=eu.thingsboard.cloud
TB_PORT=1883
TB_TLS=false
TB_KEEPALIVE=60

# Lấy từ ThingsBoard > Devices > Copy access token của từng thiết bị:
TB_TOKEN_ENVIRONMENT=
TB_TOKEN_PRESENCE=
TB_TOKEN_FAN=
TB_TOKEN_LIGHT=

# ===== 2. CẤU HÌNH CHÂN PHẦN CỨNG (GPIO CHUẨN BCM) =====
# Cảm biến DHT11 (DATA)
DHT_PIN=4

# Đèn LED (GPIO 17 nối qua điện trở 150-330 Ohm ra Anode, Cathode nối GND)
LED_PIN=17

# Quạt DC qua mạch cầu H L298N (IN1, IN2, ENA - bỏ jumper ENA để điều tốc PWM)
FAN_PIN_IN1=27
FAN_PIN_IN2=22
FAN_PIN_ENABLE=18
FAN_SPEED=1.0

# ===== 3. THAM SỐ VẬN HÀNH MẶC ĐỊNH (TÙY CHỌN) =====
# Chế độ tự động ban đầu (sẽ được cập nhật từ ThingsBoard Shared Attributes nếu có)
DEFAULT_AUTO_FAN=true
DEFAULT_AUTO_LIGHT=true

# Ngưỡng nhiệt độ bật quạt ban đầu (°C) & Thời gian duy trì đèn khi vắng mặt (giây)
DEFAULT_TEMPERATURE_THRESHOLD=30.0
DEFAULT_ABSENCE_TIMEOUT=10.0

# Độ trễ nhiệt tắt quạt (°C) -> Quạt tắt khi temp <= threshold - FAN_HYSTERESIS
FAN_HYSTERESIS=1.0

# Chu kỳ đọc DHT11 (tối thiểu 2.0s) & Chu kỳ vòng lặp điều khiển tự động (giây)
SAMPLE_INTERVAL=5.0
CONTROL_INTERVAL=1.0
TEMPERATURE_MAX_AGE=60.0

# ===== 4. CAMERA CSI & NHẬN DIỆN NGƯỜI (OPENCV HAAR CASCADE) =====
CAMERA_RESOLUTION=640,480
CAMERA_PREVIEW=false
HAAR_CASCADE_PATH=
HAAR_SCALE_FACTOR=1.1
HAAR_MIN_NEIGHBORS=3
HAAR_MIN_SIZE=60,120
DETECT_INTERVAL=0.3
DETECT_CONFIRM_FRAMES=2
DETECT_HOLD_SECONDS=2.0

# ===== 5. HỆ THỐNG GHI LOG =====
LOG_LEVEL=INFO
