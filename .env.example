# ==============================================================================
# SMART ROOM LITE - FILE CẤU HÌNH MẪU (.env.example)
# Hướng dẫn: Sao chép file này thành .env và điền các access token từ ThingsBoard:
#   cp .env.example .env
# Chú ý: Các dòng chú thích (#) phải nằm ở dòng riêng biệt.
# ==============================================================================

# ===== ThingsBoard (MQTT Server) =====
TB_HOST=eu.thingsboard.cloud
TB_PORT=1883
TB_TLS=false
TB_KEEPALIVE=60

# ===== Access Token của 4 Device (Lấy từ ThingsBoard > Devices > Copy access token) =====
# Điền 4 token tương ứng vào sau dấu = (để trống sẽ báo lỗi khi khởi động)
TB_TOKEN_ENVIRONMENT=
TB_TOKEN_PRESENCE=
TB_TOKEN_FAN=
TB_TOKEN_LIGHT=

# ===== Cấu hình Chân GPIO (Đánh số theo chuẩn BCM, KHÔNG dùng số chân vật lý) =====
# Cảm biến DHT11 (Chân DATA)
DHT_PIN=4

# Đèn LED (Anode nối qua trở 220-330 Ohm vào GPIO17, Cathode nối GND)
LED_PIN=17

# Quạt DC điều khiển qua mạch cầu H (L298N): IN1, IN2, ENABLE (bỏ jumper ENA)
FAN_PIN_IN1=27
FAN_PIN_IN2=22
FAN_PIN_ENABLE=18
# Ghi chú: Nếu dùng module MOSFET 1 chân điều khiển: để trống FAN_PIN_IN2
# Tốc độ quạt ban đầu (0.0 đến 1.0)
FAN_SPEED=1.0

# ===== Cảm biến Nhiệt độ & Độ ẩm =====
# Chu kỳ đọc DHT11 (giây, cảm biến DHT11 cần tối thiểu 2 giây giữa các lần đọc)
SAMPLE_INTERVAL=5.0

# ===== Camera CSI & Thuật toán Haar Cascade =====
CAMERA_RESOLUTION=640,480
# Đường dẫn file Haar Cascade. Để trống = tự động tìm file trong resources/haarcascade_fullbody.xml
HAAR_CASCADE_PATH=
HAAR_SCALE_FACTOR=1.1
HAAR_MIN_NEIGHBORS=3
# Kích thước tối thiểu của người (rộng, cao tính bằng pixel)
HAAR_MIN_SIZE=60,120
# Khoảng nghỉ giữa các lần phân tích khung hình (giây)
DETECT_INTERVAL=0.3
# Số khung hình liên tiếp phát hiện thấy người mới coi là "có người" (chống nhiễu)
DETECT_CONFIRM_FRAMES=2
# Giữ trạng thái "có người" thêm bấy nhiêu giây sau khung hình cuối (chống nhấp nháy)
DETECT_HOLD_SECONDS=2.0
# Hiển thị cửa sổ hình ảnh camera trực tiếp trên màn hình Pi (xem qua VNC / HDMI)
CAMERA_PREVIEW=false

# ===== Tham số & Ngưỡng Vận hành Mặc định của Phòng =====
# Chế độ tự động ban đầu cho từng thiết bị (trước khi ThingsBoard gửi shared attribute)
DEFAULT_AUTO_FAN=true
DEFAULT_AUTO_LIGHT=true

# Ngưỡng nhiệt độ bật quạt ban đầu (°C)
DEFAULT_TEMPERATURE_THRESHOLD=30.0

# Thời gian duy trì đèn sau khi người rời khỏi phòng (giây)
DEFAULT_ABSENCE_TIMEOUT=10.0

# Độ trễ nhiệt để tắt quạt (°C) -> Quạt tắt khi nhiệt độ <= ngưỡng - FAN_HYSTERESIS
FAN_HYSTERESIS=1.0

# Tuổi thọ tối đa của dữ liệu nhiệt độ (giây). Quá thời gian này coi như mất dữ liệu -> quạt tự tắt
TEMPERATURE_MAX_AGE=60.0

# Chu kỳ đánh giá logic tự động của AutoController (giây)
CONTROL_INTERVAL=1.0

# ===== Logging =====
# Mức độ ghi log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
